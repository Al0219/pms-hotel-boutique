# Valores exclusivos para Docker local. No usar secretos reales.
PMS_POSTGRES_PASSWORD=pms-local-development
PMS_WEB_PORT=3000
NEXT_PUBLIC_USE_MOCK_API=true

# Para crear el primer SUPER_ADMIN, definir los tres valores solo en el despliegue.
# Nunca versionar estas credenciales ni un PMS_JWT_SECRET de producción.
PMS_JWT_SECRET=
PMS_BOOTSTRAP_ADMIN_USERNAME=
PMS_BOOTSTRAP_ADMIN_EMAIL=
PMS_BOOTSTRAP_ADMIN_PASSWORD=
