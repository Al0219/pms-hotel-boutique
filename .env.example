# Valores exclusivos para Docker local. No usar secretos reales.
PMS_POSTGRES_PASSWORD=pms-local-development
PMS_WEB_PORT=3000
NEXT_PUBLIC_USE_MOCK_API=true

# Para crear el primer SUPER_ADMIN, definir los tres valores solo en el despliegue.
# Nunca versionar estas credenciales ni un PMS_JWT_SECRET de producción.
PMS_JWT_SECRET=
PMS_RESERVATION_LINK_OTP_HMAC_KEY=
PMS_BOOTSTRAP_ADMIN_USERNAME=
PMS_BOOTSTRAP_ADMIN_EMAIL=
PMS_BOOTSTRAP_ADMIN_PASSWORD=

# Guest Google OIDC y Resend. Mantener vacíos en Docker local si no se prueba el proveedor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/guest/google/callback
PMS_WEB_PUBLIC_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=
