          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Backend no emite Set-Cookie', () => pm.expect(pm.response.headers.has('Set-Cookie')).to.eql(false));",
                  "if (pm.response.code === 200) pm.test('URL de autorización', () => pm.expect(pm.response.json().authorizationUrl).to.be.a('string')); "
                ]
              }
            }
          ]
        },
