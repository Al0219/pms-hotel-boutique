  "item": [
    {
      "name": "Staff — Auth explícita y compatibilidad",
      "description": "BE-005-AUTH-API-01. Completar staffUsername/staffPassword SOLO localmente. Tokens se guardan localmente para la secuencia; borrar credenciales/tokens antes de exportar. Cookie jar vacío para probar refresh ausente.",
      "item": [
        {
          "name": "01 — Iniciar sesión explícita",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/staff-auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{staffUsername}}\",\"password\":\"{{staffPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Backend no emite Set-Cookie', () => pm.expect(pm.response.headers.has('Set-Cookie')).to.eql(false));",
                  "if (pm.response.code === 201) { const b = pm.response.json(); pm.test('Contrato tokens BFF', () => pm.expect(b).to.have.all.keys('accessToken','refreshToken','accessTokenExpiresInSeconds')); pm.collectionVariables.set('staffAccessToken', b.accessToken); pm.collectionVariables.set('staffRefreshToken', b.refreshToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "02 — Sesión legacy C2",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/staff-auth/session",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Backend no emite Set-Cookie', () => pm.expect(pm.response.headers.has('Set-Cookie')).to.eql(false));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('_staffAliasView', JSON.stringify(pm.response.json()));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 — Usuario actual equivalente",
