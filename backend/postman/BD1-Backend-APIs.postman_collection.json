    {
      "name": "Guest — vínculo de reserva histórica",
      "description": "Ejecutar en orden con JWT Guest vigente. El OTP llega al correo de la reserva; la API no lo devuelve.",
      "item": [
        {
          "name": "01 — Solicitar desafío OTP",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/guest-auth/reservation-links/challenges",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"confirmationCode\":\"{{confirmationCode}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) { const body = pm.response.json(); pm.test('Request ID opaco', () => pm.expect(body.requestId).to.match(/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/)); pm.collectionVariables.set('requestId', body.requestId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "02 — Verificar OTP y vincular reserva",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/guest-auth/reservation-links/verify",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"requestId\":\"{{requestId}}\",\"otp\":\"{{otp}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
                  "if (pm.response.code === 204) pm.test('Sin cuerpo', () => pm.expect(pm.response.text()).to.be.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Staff — reportes On-books diario",
      "description": "Usar JWT Staff vigente con COMMERCIAL_MANAGE. Para ALL_PROPERTIES también requiere MULTI_PROPERTY_READ. No guardar tokens reales al exportar.",
      "item": [
        {
          "name": "GET On-books diario — property",
          "request": {
            "method": "GET",
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{staffAccessToken}}", "type": "string"}]},
            "url": "{{baseUrl}}/api/v1/reports/on-books/daily?from={{from}}&to={{to}}&propertyId={{propertyId}}"
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('No cache privado', () => { const cache = pm.response.headers.get('Cache-Control') || ''; pm.expect(cache).to.include('private'); pm.expect(cache).to.include('no-store'); });",
            "if (pm.response.code === 200) { const body = pm.response.json(); pm.test('DTO On-books', () => { pm.expect(body.calculatedAt).to.be.a('string'); pm.expect(body.rows).to.be.an('array'); body.rows.forEach(row => { pm.expect(row.propertyId).to.eql(pm.collectionVariables.get('propertyId')); pm.expect(row).to.have.all.keys('propertyId','timezone','currency','stayDate','physicalRooms','outOfOrderRooms','availableRooms','onBooksRooms','onBooksPercent','unavailableReason'); }); }); }"
          ]}}]
        },
        {
          "name": "GET On-books diario — ALL_PROPERTIES",
          "request": {
            "method": "GET",
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{staffAccessToken}}", "type": "string"}]},
            "url": "{{baseUrl}}/api/v1/reports/on-books/daily?from={{from}}&to={{to}}&scope=ALL_PROPERTIES"
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('No cache privado', () => { const cache = pm.response.headers.get('Cache-Control') || ''; pm.expect(cache).to.include('private'); pm.expect(cache).to.include('no-store'); });",
            "if (pm.response.code === 200) { const body = pm.response.json(); pm.test('Filas ordenadas', () => { const keys = body.rows.map(row => row.propertyId + '/' + row.stayDate); pm.expect(keys).to.eql([...keys].sort()); }); }"
          ]}}]
        }
      ]
    },
    {
      "name": "Public Availability — A3",
      "item": [
        {
          "name": "GET disponibilidad pública — sin credenciales",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/v1/public/availability?propertyId={{propertyId}}&arrival={{publicArrival}}&departure={{publicDeparture}}&rooms={{publicRooms}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const body = pm.response.json(); pm.test('DTO público GTQ', () => { pm.expect(body).to.have.all.keys('propertyId','arrival','departure','currency','offers'); pm.expect(body.currency).to.eql('GTQ'); pm.expect(body.propertyId).to.eql(pm.variables.get('propertyId')); pm.expect(body.offers).to.be.an('array'); body.offers.forEach(o => { pm.expect(o).to.have.all.keys('roomTypeId','roomTypeCode','roomTypeName','ratePlanId','ratePlanCode','availableUnits','nightlyRateMinor','totalMinor'); pm.expect(o.availableUnits).to.be.at.least(Number(pm.variables.get('publicRooms'))); pm.expect(o.ratePlanId).to.eql(o.ratePlanCode); }); }); }"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
